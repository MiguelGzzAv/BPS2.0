# ----------------------------------------------------
# Docker Compose Environment Variables
# ----------------------------------------------------
# Create a copy of this file named .env and fill in the values.
# This file is used by docker-compose to configure the services.

# --- PostgreSQL Database Settings ---
# These credentials will be used to initialize the database container.
# The 'server' service will also use them to connect to the database.
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_DATABASE=monitoring_app
DB_PORT=5432 # Port on the host machine to map to the container's port 5432

# --- Application Settings ---
# You can add other environment variables for your application here.
NODE_ENV=development